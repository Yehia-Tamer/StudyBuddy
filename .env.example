# Copy to .env and fill in real values:  cp .env.example .env
# .env is git-ignored. Never commit real secrets.

# --- Database ---------------------------------------------------------------
# Local development without Docker (Postgres installed on your machine):
DATABASE_URL=postgresql://user:password@localhost:5432/studybuddy
# Docker Compose: the db container is created from these on its FIRST start
# (changing them later does not change an existing database's password).
# docker-compose.yml builds the backend's DATABASE_URL from them (host "db").
# Letters and numbers only for the password (special characters break the URL).
POSTGRES_USER=studybuddy
POSTGRES_PASSWORD=change-me-generate-with-openssl-rand-hex-24
POSTGRES_DB=studybuddy

# --- Auth -------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Google Gemini (separate key pools per task) ----------------------------
GOOGLE_API_KEY_1=
GOOGLE_API_KEY_2=
GOOGLE_API_KEY_3=
MULTI_RETRIEVER_KEY_1=
MULTI_RETRIEVER_KEY_2=
MULTI_RETRIEVER_KEY_3=
QUERY_ADJ_KEY_1=
QUERY_ADJ_KEY_2=
QUERY_ADJ_KEY_3=
# Optional: only used if embeddings.py is switched to the Gemini embedding path
EMBEDDING_KEY_1=
EMBEDDING_KEY_2=
EMBEDDING_KEY_3=

# --- Web search -------------------------------------------------------------
TAVILY_API_KEY=

# --- OCR (Windows only, optional) -------------------------------------------
# Linux/Docker finds tesseract and poppler on PATH. On Windows, set these only
# if yours are installed somewhere other than the defaults in pdf_loader.py.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# POPPLER_PATH=C:\poppler-26.02.0\Library\bin
